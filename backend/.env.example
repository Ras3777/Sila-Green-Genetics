PORT=3001
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sgip?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_ISSUER="sgip-api"
JWT_AUDIENCE="sgip-client"
REALTIME_ALLOWED_ORIGINS="http://localhost:3000"
# Optional: enables cross-instance Socket.IO fan-out.
REDIS_URL="redis://localhost:6379"
REALTIME_REDIS_REQUIRED="false"
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"
CACHE_KEY_PREFIX="sgip:cache:v1"
CACHE_DEFAULT_TTL_SECONDS="60"
CACHE_DEFAULT_STALE_SECONDS="30"
CACHE_FAIL_OPEN="true"
CACHE_LOCK_TTL_MS="5000"
CACHE_LOCK_WAIT_MS="2500"
CACHE_MAX_VALUE_BYTES="512000"
