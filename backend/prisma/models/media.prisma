// MEDIA DOMAIN

model FileAsset {
  id           String    @id @default(uuid())
  mediaType    MediaType
  fileName     String
  mimeType     String?
  storageKey   String    @unique
  sizeBytes    BigInt?
  checksumSha256 String?
  metadata     Json?
  createdAt    DateTime  @default(now())

  animalMedia      AnimalMedia[]
  rawForAssays     GenotypingAssay[] @relation("RawGenotypeFile")
  processedForAssays GenotypingAssay[] @relation("ProcessedGenotypeFile")
  conditionCertificates AnimalGeneticConditionResult[]
  widthPx Int?
  heightPx Int?
  durationSeconds Int?
  movementDocuments AnimalMovement[] @relation("MovementDocument")
  parentageEvidence ParentageEvidence[]
  marketplaceDocuments MarketplaceListingDocument[]
  marketplaceInspectionFiles MarketplaceInspectionFile[]
  investigationEvidence InvestigationEvidenceLink[]
  officialCertificates OfficialCertificate[]
  verificationRetainedFiles CertificateVerificationAttempt[]
  governmentReportRuns GovernmentReportRun[]
  @@schema("bovine_media")
}

model AnimalMedia {
  id        String   @id @default(uuid())
  animalId  String
  fileId    String
  title     String?
  caption   String?
  takenAt   DateTime?
  createdAt DateTime @default(now())

  animal Animal    @relation(fields: [animalId], references: [id], onDelete: Cascade)
  file   FileAsset @relation(fields: [fileId], references: [id], onDelete: Cascade)

  category MediaCategory @default(OTHER)
  visibility MediaVisibility @default(PRIVATE)
  verificationStatus MediaVerificationStatus @default(UNVERIFIED)
  capturedById String?
  farmId String?
  herdId String?
  isProfile Boolean @default(false)
  isMarketplaceEligible Boolean @default(false)
  archivedAt DateTime?
  tagsMetadata Json?
  capturedBy User? @relation("AnimalMediaCapturedBy", fields: [capturedById], references: [id], onDelete: SetNull)
  farm Farm? @relation(fields: [farmId], references: [id], onDelete: SetNull)
  herd Herd? @relation(fields: [herdId], references: [id], onDelete: SetNull)
  tags AnimalMediaTag[]
  albumItems MediaAlbumItem[]
  links MediaLink[]
  comments MediaComment[]
  verifications MediaVerification[]
  marketplaceSelections MarketplaceListingMedia[]
  @@unique([animalId, fileId])
  @@schema("bovine_media")
}

model MediaTag {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())

  mediaLinks AnimalMediaTag[]
  @@schema("bovine_media")
}

model AnimalMediaTag {
  animalMediaId String
  tagId         String
  createdAt     DateTime @default(now())

  media AnimalMedia @relation(fields: [animalMediaId], references: [id], onDelete: Cascade)
  tag   MediaTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([animalMediaId, tagId])
  @@index([tagId])
  @@schema("bovine_media")
}

model MediaAlbum {
  id          String   @id @default(uuid())
  animalId    String
  createdById String?
  name        String
  description String?
  coverMediaId String?
  automaticKey String?
  archivedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  animal    Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)
  createdBy User?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  items     MediaAlbumItem[]

  @@index([animalId, createdAt])
  @@schema("bovine_media")
}

model MediaAlbumItem {
  id            String   @id @default(uuid())
  albumId       String
  animalMediaId String
  displayOrder  Int      @default(0)
  addedAt       DateTime @default(now())

  album MediaAlbum  @relation(fields: [albumId], references: [id], onDelete: Cascade)
  media AnimalMedia @relation(fields: [animalMediaId], references: [id], onDelete: Cascade)

  @@unique([albumId, animalMediaId])
  @@index([albumId, displayOrder])
  @@schema("bovine_media")
}

model MediaLink {
  id            String            @id @default(uuid())
  animalMediaId String
  entityType    String
  entityId      String
  relationType  MediaRelationType @default(SUPPORTING)
  createdAt     DateTime          @default(now())

  media AnimalMedia @relation(fields: [animalMediaId], references: [id], onDelete: Cascade)

  @@unique([animalMediaId, entityType, entityId, relationType])
  @@index([entityType, entityId])
  @@schema("bovine_media")
}

model MediaComment {
  id            String   @id @default(uuid())
  animalMediaId String
  authorUserId  String
  message       String
  resolvedAt    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  media  AnimalMedia @relation(fields: [animalMediaId], references: [id], onDelete: Cascade)
  author User        @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([animalMediaId, createdAt])
  @@schema("bovine_media")
}

model MediaVerification {
  id            String                  @id @default(uuid())
  animalMediaId String
  verifierUserId String
  status        MediaVerificationStatus
  reason        String?
  verifiedAt    DateTime                @default(now())

  media    AnimalMedia @relation(fields: [animalMediaId], references: [id], onDelete: Cascade)
  verifier User        @relation(fields: [verifierUserId], references: [id], onDelete: Cascade)

  @@index([animalMediaId, verifiedAt])
  @@schema("bovine_media")
}
